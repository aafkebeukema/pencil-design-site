---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/with-base';
---

<Layout
  title="About Pencil Design | London Kitchen Fit-Out Company"
  description="Learn about Pencil Design, a London-based team specialising in bespoke kitchen installation, planning and fitting."
>

  <!-- ===========================
       PAGE HEADER
  ============================ -->
  <div class="page-header">
    <h1>About Us</h1>
  </div>

  <!-- ===========================
       INTRO — full-width text
  ============================ -->
  <section class="intro">
    <div class="intro-inner">
      <p>
        Pencil Design is a design-led kitchen fit-out company based in South East London, offering bespoke kitchen interiors that are built to last. We provide installation and full design support for <a href={withBase('/private-clients')}>private clients</a>, as well as kitchen installation services for the <a href={withBase('/retail')}>retail sector</a>.
      </p>
      <p>
        With a strong foundation in architecture, design and construction, we take on projects as part of home renovations and new builds. Our approach combines thoughtful design, planning and delivery with practical know-how, ensuring that every project is fully tailored, practical to build and delivered with care. At Pencil Design, we offer a personalised approach that aims to leave a lasting impression, as well as a beautiful end product.
      </p>
    </div>
  </section>

  <!-- ===========================
       TEAM
  ============================ -->
  <section class="team">
    <div class="team-inner">
      <p class="section-label">Meet the team</p>
      <div class="team-grid">
        <div class="team-member">
          <div class="team-photo-wrap">
            <img
              class="team-photo"
              src={withBase('/images/about-sam.jpg')}
              alt="Sam, of Pencil Design"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="team-text">
            <h3>Sam</h3>
            <p>
              Sam comes from an architecture, design and construction background and brings a strong practical understanding of how spaces should work as well as how they should be built. He has worked across house renovations, kitchens, bathrooms, bespoke furniture and larger building projects, combining hands-on experience with a strong eye for detail. His ability to understand a project from both the design and construction side is a big part of what he brings to Pencil Design.
            </p>
          </div>
        </div>
        <div class="team-member">
          <div class="team-photo-wrap">
            <img
              class="team-photo"
              src={withBase('/images/about-alexander.jpg')}
              alt="Alexander, of Pencil Design"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="team-text">
            <h3>Alexander</h3>
            <p>
              Alexander comes from an engineering management background and brings a large amount of organisational talent and a keen eye for design. He has worked on major design &amp; build projects in lead functions, yet never lost his sense of how to do house renovations, or bespoke kitchen works himself. His talent to pull things together and to keep projects on track is only one of many he brings to Pencil Design.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===========================
       CTA
  ============================ -->
  <section class="cta">
    <div class="cta-inner">
      <h2>Ready to start a project?</h2>
      <p>Get in touch and we'll arrange a free, no-obligation consultation to discuss what you have in mind.</p>
      <a href={withBase('/contact')} class="btn">Get in touch</a>
    </div>
  </section>

</Layout>

<style>
  /* ===========================
     PAGE HEADER
  ============================ */
  .page-header {
    padding: calc(var(--header-h) + 2rem) var(--site-gutter) 2rem;
    max-width: var(--site-max);
    margin: 0 auto;
    text-align: left;
  }

  .page-header h1 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2rem, 9vw, 7rem);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  /* ===========================
     INTRO
  ============================ */
  .intro {
    padding: 2rem var(--site-gutter) 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .intro-inner {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }

  .intro-inner p {
    font-size: clamp(1rem, 1.3vw, 1.05rem);
    line-height: 1.85;
    color: var(--color-black);
    font-weight: 300;
  }

  .intro-inner a {
    text-underline-offset: 0.18em;
  }

  /* ===========================
     TEAM
  ============================ */
  .team {
    padding: 3rem var(--site-gutter) 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  .team-inner {
    max-width: 1300px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 1.5rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 560px));
    justify-content: center;
    gap: 2rem;
  }

  .team-member {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .team-photo-wrap {
    flex: none;
    width: 155px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-off-white);
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-text {
    min-width: 0;
  }

  .team-text h3 {
    margin-top: 0;
  }

  .team-member h3 {
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .team-member p {
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--color-mid);
    font-weight: 300;
  }

  @media (max-width: 800px) {
    .team-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .team-member {
      flex-direction: column;
    }

    .team-photo-wrap {
      width: 160px;
    }
  }

  /* ===========================
     CTA
  ============================ */
  .cta {
    background: var(--color-black);
    padding: 7rem var(--site-gutter);
    text-align: center;
    color: var(--color-white);
  }

  .cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    margin-bottom: 1.25rem;
  }

  .cta p {
    opacity: 0.6;
    margin-bottom: 2.75rem;
    line-height: 1.7;
    font-size: 1rem;
    font-weight: 300;
  }

  .btn {
    display: inline-block;
    padding: 0.9rem 1.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid var(--color-white);
    transition: background 0.2s, color 0.2s;
  }

  .btn:hover {
    background: transparent;
    color: var(--color-white);
  }
</style>
