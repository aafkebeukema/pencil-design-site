---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { projectPages } from '../data/project-pages';
import { withBase } from '../lib/with-base';

const projects = projectPages.flatMap((project) =>
  project.images.map((image) => ({
    ...image,
    title: project.title,
    href: withBase(`/projects/${project.slug}`),
    src: image.src,
  })),
);

const kitchenProjects = projects.filter((project) => project.category === 'kitchens');
const otherProjects = projects.filter((project) => project.category === 'other');
---

<Layout
  title="Kitchen Installation Projects in London | Pencil Design"
  description="Explore Pencil Design’s kitchen installation projects across London, including cabinetry, worktops, finishes and flooring."
>
  <div class="projects-main">
    <div class="page-intro">
      <h1>Our Work</h1>
      <h2 class="page-subtitle">Custom Kitchen Installation &amp; Joinery</h2>
    </div>

    <section class="projects-grid-section" aria-labelledby="kitchens-heading">
      <h2 id="kitchens-heading" class="projects-section-heading">Kitchens</h2>
      <div class="projects-grid">
        {kitchenProjects.map((project, index) => (
          <a class="project-item" href={project.href} aria-label={`View ${project.title} project`}>
            <div class="project-image">
              <ResponsiveImage
                src={project.src}
                alt={project.alt}
                sizes="(max-width: 520px) 100vw, (max-width: 900px) 50vw, 33vw"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
              />
            </div>
            <p class="caption-title">{project.title}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="projects-grid-section" aria-labelledby="other-works-heading">
      <h2 id="other-works-heading" class="projects-section-heading">Other works</h2>
      <div class="projects-grid">
        {otherProjects.map((project) => (
          <a class="project-item" href={project.href} aria-label={`View ${project.title} project`}>
            <div class="project-image">
              <ResponsiveImage
                src={project.src}
                alt={project.alt}
                sizes="(max-width: 520px) 100vw, (max-width: 900px) 50vw, 33vw"
                loading="lazy"
              />
            </div>
            <p class="caption-title">{project.title}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="projects-cta">
      <div class="projects-cta-inner">
        <h2>Have a project in mind?</h2>
        <p>Get in touch and we'll arrange a free consultation to talk through what you're looking for.</p>
        <a href={withBase('/contact')} class="btn">Get in touch</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .projects-main {
    background: var(--color-white);
  }

  /* ── Page intro ── */
  .page-intro {
    padding: calc(var(--header-h) + 3.5rem) var(--site-gutter) 2.5rem;
    max-width: var(--site-max);
    margin: 0 auto;
  }

  .page-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-bottom: 0.75rem;
  }

  .page-intro h1 {
    font-family: var(--font-body);
    font-size: clamp(2rem, 9vw, 7rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .page-subtitle {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mid);
    margin-top: 1rem;
    font-weight: 400;
  }

  .page-intro-copy {
    max-width: 42rem;
    margin-top: 1.25rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.75;
    color: #555;
  }

  /* ── Grid ── */
  .projects-grid-section {
    padding: 0 var(--site-gutter) 5rem;
    max-width: var(--site-max);
    margin: 0 auto;
  }

  .projects-section-heading {
    margin: 0 0 1.5rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /*
   * row-gap: 0 so the grid itself adds no vertical space between rows.
   * The caption's padding-bottom (20px) becomes the sole gap between
   * the caption text and the top of the next image row — matching the
   * column-gap (20px) exactly.
   */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: 48px;
    row-gap: 0;
  }

  .project-item {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .project-item:hover :global(.project-image .responsive-image) { transform: scale(1.02); }

  .project-image {
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    background: var(--color-off-white);
  }

  :global(.project-image .responsive-image) {
    transition: transform 0.25s ease;
  }

  .caption-title {
    padding-top: 10px;
    padding-bottom: 20px;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-black);
    font-weight: 500;
  }

  /* Last row: no padding-bottom after final captions */
  .project-item:nth-last-child(-n+3) .caption-title {
    padding-bottom: 0;
  }

  /* ── CTA ── */
  .projects-cta {
    background: var(--color-off-white);
    padding: 6rem var(--site-gutter);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .projects-cta-inner {
    max-width: 520px;
    margin: 0 auto;
  }

  .projects-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    margin-bottom: 1rem;
  }

  .projects-cta p {
    color: var(--color-mid);
    margin-bottom: 2.25rem;
    line-height: 1.7;
    font-weight: 300;
  }

  .btn {
    display: inline-block;
    padding: 0.9rem 1.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    background: var(--color-black);
    color: var(--color-white);
    border: 1px solid var(--color-black);
    transition: background 0.2s, color 0.2s;
  }

  .btn:hover {
    background: transparent;
    color: var(--color-black);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
    }
    .caption-title { padding-bottom: 14px; }
    .project-item:nth-last-child(-n+2) .caption-title { padding-bottom: 0; }
  }

  @media (max-width: 520px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .caption-title { padding-bottom: 12px; }
    .project-item:last-child .caption-title { padding-bottom: 0; }
  }
</style>
