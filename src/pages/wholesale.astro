---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/with-base';

const serviceImageSets = {
  design: [
    { src: '/images/wholesale-design-01.jpg', alt: 'Joinery design concept illustration' },
    { src: '/images/wholesale-design-02.jpeg', alt: 'Measured joinery design drawing and planning work' },
    { src: '/images/wholesale-design-03.jpg', alt: 'Bespoke joinery design materials and samples' },
    { src: '/images/wholesale-design-04.jpg', alt: 'Joinery design detailing for a fitted project' },
    { src: '/images/wholesale-design-05.jpg', alt: 'Design development for bespoke fitted furniture' },
  ],
  build: [
    { src: '/images/wholesale-build-01.jpg', alt: 'Joinery work in progress in the workshop', size: '118%', position: 'center' },
    { src: '/images/wholesale-build-02.jpg', alt: 'Bespoke furniture being built by hand', size: '118%', position: 'center' },
    { src: '/images/wholesale-build-03.jpg', alt: 'Custom joinery assembly in the workshop', size: '118%', position: 'center' },
    { src: '/images/wholesale-build-04.jpg', alt: 'Joinery craftsmanship and cabinet construction', size: '118%', position: 'center' },
    { src: '/images/wholesale-build-05.jpg', alt: 'Workshop build stage for fitted furniture', size: '118%', position: 'center' },
  ],
  finish: [
    { src: '/images/wholesale-finish-01.jpg', alt: 'Finished bespoke joinery detail and paintwork' },
    { src: '/images/wholesale-finish-02.jpg', alt: 'Finished wholesale joinery detail' },
    { src: '/images/wholesale-finish-03.jpg', alt: 'Finished wholesale joinery detail' },
    { src: '/images/wholesale-finish-04.jpg', alt: 'Finished wholesale joinery detail' },
    { src: '/images/wholesale-finish-05.jpg', alt: 'Final joinery finish and installation detail' },
  ],
};

const services = [
  {
    label: 'Receipt of order',
    body: 'We take stock of the kitchen items and store them safely.',
    images: serviceImageSets.design,
  },
  {
    label: 'Bespoke fitting',
    body: 'We fit most types of kitchens, including plumbing, electrics, tiling and associated flooring works.',
    images: serviceImageSets.build,
  },
  {
    label: 'Quality handover',
    body: 'We ensure every detail meets the customer’s satisfaction, along with any adaptations that arise during the fitting stage.',
    images: serviceImageSets.finish,
  },
];

Object.values(serviceImageSets).forEach((imageSet) => {
  imageSet.forEach((image) => {
    image.src = withBase(image.src);
  });
});
---

<Layout
  title="Retail | Pencil Design"
  description="Pre-designed kitchen fitting across London, including plumbing, electrics, tiling and flooring works."
>

  <!-- ===========================
       PAGE HEADER — large, centred, bold
  ============================ -->
  <div class="page-header">
    <h1>Retail</h1>
    <p class="page-tagline">We have the capacity to fit pre-designed kitchens to a very high standard across London.</p>
  </div>

  <!-- ===========================
       THREE-COLUMN SERVICES
  ============================ -->
  <section class="services-section">
    <div class="services-cols">
      {services.map(service => (
        <div class="service-col">
          <div class="service-body">
            <p class="service-label">{service.label}</p>
            <p class="service-desc">{service.body}</p>
          </div>

          <div class="service-circles">
            {service.images.map((image) => (
              <div class="service-img-wrap service-img-wrap--circle">
                <img
                  class="service-img"
                  src={image.src}
                  alt={image.alt}
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${image.position ?? 'center'}; --image-scale: ${image.size ? Number.parseFloat(image.size) / 100 : 1};`}
                />
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>
  </section>

  <!-- ===========================
       CTA
  ============================ -->
  <section class="cta">
    <div class="cta-inner">
      <h2>Ready to get started?</h2>
      <p>Get in touch and we'll arrange a free, no-obligation consultation to discuss your project.</p>
      <a href={withBase('/contact')} class="btn">Get in touch</a>
    </div>
  </section>

</Layout>

<style>
  /* ===========================
     PAGE HEADER
  ============================ */
  .page-header {
    padding: calc(var(--header-h) + 3rem) var(--site-gutter) 3rem;
    max-width: var(--site-max);
    margin: 0 auto;
    text-align: left;
  }

  .page-header h1 {
    /* Very large, heavy — nearly spans the full viewport width */
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2rem, 9vw, 7rem);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: 1.75rem;
  }

  .page-tagline {
    /* Big statement — not a caption */
    font-size: clamp(1.1rem, 2vw, 1.7rem);
    color: var(--color-black);
    font-weight: 400;
    width: auto;
    max-width: 34ch;
    margin: 0;
    line-height: 1.3;
    white-space: normal;
  }

  /* ===========================
     SERVICES COLUMNS
  ============================ */
  .services-section {
    padding-top: 1rem;
  }

  .services-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1200px;
    margin: 0 auto;
  }

  .service-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 2.5rem 1.75rem 3.5rem;
    text-align: center;
  }

  /* ---- Images ---- */
  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(var(--image-scale, 1));
    transform-origin: center;
  }

  .service-img-wrap--circle {
    width: min(85%, 270px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-off-white);
  }

  .service-circles {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    justify-items: center;
    margin-top: auto;
    padding-top: 2.5rem;
  }

  /* ---- Text below image ---- */
  .service-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 34ch;
  }

  /* "DESIGN IT", "MAKE IT" etc. — the main title, prominent */
  .service-label {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-black);
    margin-bottom: 1rem;
  }

  .service-desc {
    font-size: 0.875rem;
    color: #555;
    line-height: 1.85;
    font-weight: 300;
  }

  /* Tablet: 2 columns */
  @media (max-width: 640px) {
    .services-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 420px) {
    .services-cols {
      grid-template-columns: 1fr;
    }

    .service-col {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .service-col:last-child {
      border-bottom: none;
    }

    .service-img-wrap--circle {
      width: min(60%, 220px);
    }
  }

  /* ===========================
     CTA
  ============================ */
  .cta {
    background: var(--color-black);
    padding: 7rem var(--site-gutter);
    text-align: center;
    color: var(--color-white);
  }

  .cta-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 400;
    margin-bottom: 1.25rem;
  }

  .cta p {
    opacity: 0.6;
    margin-bottom: 2.75rem;
    line-height: 1.7;
    font-size: 1rem;
    font-weight: 300;
  }

  .btn {
    display: inline-block;
    padding: 0.9rem 1.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid var(--color-white);
    transition: background 0.2s, color 0.2s;
  }

  .btn:hover {
    background: transparent;
    color: var(--color-white);
  }
</style>
